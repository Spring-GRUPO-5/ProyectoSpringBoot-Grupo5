/*
 * S14-2 Demo 1: Avisos de fallo y de recuperación con post
 *
 * Objetivo: que cada construcción escriba un aviso cuando falla, cuando termina bien
 * y cuando vuelve a funcionar después de un fallo.
 *
 * Lo que hace este ejemplo:
 *   - Parte del Jenkinsfile de S14-1 Demo 2 (compilar, probar y empaquetar) sin cambiar sus etapas
 *   - Añade al final un bloque post a nivel de pipeline con las condiciones failure, success y fixed
 *   - Cada aviso incluye el nombre del job y el número de construcción
 *
 * Concepto clave: el aviso es un paso más que Jenkins ejecuta según el resultado de la construcción.
 * Aquí es un echo en la consola; en un equipo real, el mismo bloque enviaría un correo o un mensaje de chat.
 */
pipeline {

    // Cualquier agente disponible: en el aula, el propio Jenkins.
    agent any

    // Los nombres entre comillas son los de Manage Jenkins > Tools y deben coincidir letra por letra.
    tools {
        jdk 'jdk-21'
        maven 'maven-3.9'
    }

    // Parámetros interactivos para controlar la ejecución desde Jenkins
    parameters {
        booleanParam(name: 'EJECUTAR_PRUEBAS', defaultValue: true, description: 'Marcar para ejecutar las pruebas. Desmarcar para saltarlas.')
        booleanParam(name: 'EMPAQUETAR', defaultValue: true, description: 'Marcar para generar y guardar el JAR. Desmarcar para omitir la etapa Empaquetar.')
    }

    stages {

        stage('Compilar') {
            steps {
                // clean borra target/ antes de empezar. Usamos -f tienda/pom.xml para ubicar tu proyecto.
                bat 'mvn -f tienda/pom.xml -B clean compile'
            }
        }

        stage('Probar') {
            steps {
                // Se evalúa la respuesta del parámetro EJECUTAR_PRUEBAS usando comillas dobles.
                // Si la casilla está marcada -> -DskipTests=false (ejecuta pruebas).
                // Si está desmarcada -> -DskipTests=true (salta pruebas).
                bat "mvn -f tienda/pom.xml -B test -DskipTests=${!params.EJECUTAR_PRUEBAS}"
            }
            post {
                always {
                    // Los resultados se buscan dentro de la subcarpeta tienda
                    junit testResults: 'tienda/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Empaquetar') {
            // Se ejecuta solo si el parámetro EMPAQUETAR está marcado (true)
            when {
                expression { return params.EMPAQUETAR }
            }
            steps {
                // Compila y empaqueta saltando los tests para no repetirlos, apuntando a tu subcarpeta tienda
                bat 'mvn -f tienda/pom.xml -B package -DskipTests=true'
                // Archiva el artefacto .jar generado dentro del directorio tienda/target/
                archiveArtifacts artifacts: 'tienda/target/*.jar'
            }
        }
    }

    // Evaluación final del estado de todo el pipeline
    post {
        failure {
            echo "FALLO: la construccion ${env.BUILD_NUMBER} de ${env.JOB_NAME} ha fallado. Revisar la etapa en rojo."
        }

        success {
            echo "OK: la construccion ${env.BUILD_NUMBER} de ${env.JOB_NAME} ha terminado bien."
        }

        fixed {
            echo "RECUPERADA: ${env.JOB_NAME} vuelve a funcionar desde la construccion ${env.BUILD_NUMBER}."
        }
    }
}
