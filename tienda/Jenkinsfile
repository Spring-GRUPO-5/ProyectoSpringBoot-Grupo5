/*
 * S14-2 Demo 1: Avisos de fallo y de recuperación con post
 *
 * Objetivo: que cada construcción escriba un aviso cuando falla, cuando termina bien
 * y cuando vuelve a funcionar después de un fallo.
 *
 * Lo que hace este ejemplo:
 *   - Parte del Jenkinsfile de S14-1 Demo 2 (compilar, probar y empaquetar) sin cambiar sus etapas
 *   - Añade al final un bloque post a nivel de pipeline con las condiciones failure, success y fixed
 *   - Cada aviso incluye el nombre del job y el número de construcción
 *
 * Concepto clave: el aviso es un paso más que Jenkins ejecuta según el resultado de la construcción.
 * Aquí es un echo en la consola; en un equipo real, el mismo bloque enviaría un correo o un mensaje de chat.
 */
pipeline {

    // Cualquier agente disponible: en el aula, el propio Jenkins.
    agent any

    // tools le dice a Jenkins qué JDK y qué Maven debe poner en el PATH durante la construcción.
    // El servicio de Jenkins no ve el PATH del usuario que lo instaló, así que sin este bloque
    // el comando mvn no se encontraría.
    // Los nombres entre comillas son los de Manage Jenkins > Tools (S13-2) y deben
    // coincidir letra por letra con ellos; si no coinciden, Jenkins no podrá encontrar la herramienta.
    tools {
        jdk 'jdk-21'
        maven 'maven-3.9'
    }

    stages {

        stage('Compilar') {
            steps {
                // -B (batch mode) hace que Maven escriba una salida limpia, sin colores
                // ni barras de progreso, pensada para leerse en un registro y no en una terminal.
                // clean borra target/ antes de empezar: así no quedan informes de
                // pruebas de una construcción anterior que confundan a Jenkins.

                bat 'mvn -B clean compile'
            }
        }

        stage('Probar') {
            steps {
                // mvn test compila las pruebas y las ejecuta con Surefire.
                // Si una prueba falla, Maven termina con error y esta etapa se pone en rojo.
                bat 'mvn -B test'
            }
            // post define qué hacer cuando termina la etapa, según su resultado.
            post {
                // always se ejecuta siempre, también cuando las pruebas han fallado.
                // Sin él, el informe solo se publicaría con las construcciones en verde,
                // que es justo cuando menos falta hace.
                always {
                    // junit lee los informes XML de Surefire y los muestra en Jenkins.
                    // allowEmptyResults evita un segundo error si no llegó a generarse ningún informe
                    // (por ejemplo, si las pruebas ni siquiera compilan).
                    junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Empaquetar') {
            steps {
                // Las pruebas ya se ejecutaron en la etapa anterior, así que aquí las saltamos
                // con -DskipTests para no hacerlas dos veces.
                // Maven genera target/contactos-0.0.1-SNAPSHOT.jar.
                //bat 'mvn -B package -DskipTests'
                bat 'mvn -B package' //si falla no empaqueta
                // archiveArtifacts guarda el JAR dentro de Jenkins, asociado a esta construcción,
                // para poder descargarlo después. El patrón target/*.jar no incluye el
                // fichero .jar.original, porque este termina en .original.
                archiveArtifacts artifacts: 'target/*.jar'
            }
        }
    }

    // Este post está fuera de stages, al nivel de pipeline: se evalúa una sola vez, cuando han
    // terminado todas las etapas (o cuando una ha fallado y el pipeline se ha detenido).
    // El post de la etapa Probar, en cambio, se evalúa al terminar esa etapa.
    post {

        // failure: se ejecuta solo si la construcción ha terminado en rojo (Failed).
        failure {
            // env.JOB_NAME es el nombre del job ("contactos") y env.BUILD_NUMBER es el número de
            // esta construcción (7, 8, 9...). Jenkins las crea solo para cada construcción.
            // Las comillas dobles hacen que ${...} se sustituya por su valor; con comillas simples
            // saldría escrito el texto ${env.JOB_NAME}. Sin tildes, por la consola de Windows.
            echo "FALLO: la construccion ${env.BUILD_NUMBER} de ${env.JOB_NAME} ha fallado. Revisar la etapa en rojo."
        }

        // success: se ejecuta solo si la construcción ha terminado en verde (Stable).
        success {
            echo "OK: la construccion ${env.BUILD_NUMBER} de ${env.JOB_NAME} ha terminado bien."
        }

        // fixed: se ejecuta cuando esta construcción termina bien y la anterior no había terminado bien.
        // Es decir, avisa del paso de rojo a verde y no de cada verde. En una construcción que se
        // recupera se cumplen a la vez fixed y success, así que salen los dos avisos.
        fixed {
            echo "RECUPERADA: ${env.JOB_NAME} vuelve a funcionar desde la construccion ${env.BUILD_NUMBER}."
        }
    }
}